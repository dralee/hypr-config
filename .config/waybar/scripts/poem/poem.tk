{"id": 32, "title": "采桑子·彤霞久绝飞琼字", "author_id": 1, "author": "纳兰性德", "rhythmic": "采桑子", "paragraphs": [{"id": 121, "content": "彤霞久绝飞琼字，人在谁边", "sort": 0}, {"id": 122, "content": "人在谁边，今夜玉清眠不眠", "sort": 1}, {"id": 123, "content": "香销被冷残灯灭，静数秋天", "sort": 2}, {"id": 124, "content": "静数秋天，又误心期到下弦", "sort": 3}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}