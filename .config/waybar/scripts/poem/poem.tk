{"id": 63, "title": "好事近·帘外五更风", "author_id": 1, "author": "纳兰性德", "rhythmic": "好事近", "paragraphs": [{"id": 253, "content": "帘外五更风，消受晓寒时节", "sort": 0}, {"id": 254, "content": "刚剩秋衾一半，拥透帘残月", "sort": 1}, {"id": 255, "content": "争教清泪不成冰", "sort": 2}, {"id": 256, "content": "好处便轻别", "sort": 3}, {"id": 257, "content": "拟把伤离情绪，待晓寒重说", "sort": 4}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}