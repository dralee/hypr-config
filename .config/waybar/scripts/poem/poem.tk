{"id": 171, "title": "昭君怨·深禁好春谁惜", "author_id": 1, "author": "纳兰性德", "rhythmic": "昭君怨", "paragraphs": [{"id": 789, "content": "深禁好春谁惜，薄暮瑶阶伫立", "sort": 0}, {"id": 790, "content": "别院管弦声，不分明", "sort": 1}, {"id": 791, "content": "又是梨花欲谢，绣被春寒今夜", "sort": 2}, {"id": 792, "content": "寂寞锁朱门，梦承恩", "sort": 3}], "notes": null, "dynasty": "清代", "category_id": 11, "category": "纳兰性德", "content_type": 0}