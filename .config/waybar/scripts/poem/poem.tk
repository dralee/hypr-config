{"id": 100, "title": "满庭芳·堠雪翻鸦", "author_id": 1, "author": "纳兰性德", "rhythmic": "满庭芳", "paragraphs": [{"id": 419, "content": "堠雪翻鸦，河冰跃马，惊风吹度龙堆", "sort": 0}, {"id": 420, "content": "阴磷夜泣，此景总堪悲", "sort": 1}, {"id": 421, "content": "待向中宵起舞，无人处、那有村鸡", "sort": 2}, {"id": 422, "content": "只应是，金笳暗拍，一样泪沾衣", "sort": 3}, {"id": 423, "content": "须知今古事，棋枰胜负，翻覆如斯", "sort": 4}, {"id": 424, "content": " ", "sort": 5}, {"id": 425, "content": "叹纷纷蛮触，回首成非", "sort": 6}, {"id": 426, "content": "剩得几行青史，斜阳下、断碣残碑", "sort": 7}, {"id": 427, "content": "年华共，混同江水，流去几时回", "sort": 8}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}