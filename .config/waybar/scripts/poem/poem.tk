{"id": 95, "title": "采桑子·凉生露气湘弦润", "author_id": 1, "author": "纳兰性德", "rhythmic": "采桑子", "paragraphs": [{"id": 388, "content": "凉生露气湘弦润，暗滴花梢", "sort": 0}, {"id": 389, "content": "帘影谁摇，燕蹴风丝上柳条", "sort": 1}, {"id": 390, "content": "舞鹍镜匣开频掩，檀粉慵调", "sort": 2}, {"id": 391, "content": "朝泪如潮，昨夜香衾觉梦遥", "sort": 3}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}