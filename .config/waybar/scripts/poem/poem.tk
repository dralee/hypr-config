{"id": 229, "title": "盛京", "author_id": 1, "author": "纳兰性德", "rhythmic": "南海子", "paragraphs": [{"id": 1051, "content": "拔地蛟龙宅，当关虎豹城", "sort": 0}, {"id": 1052, "content": "山连长白秀，江入混同清", "sort": 1}, {"id": 1053, "content": "庙社灵风肃，豪强右族更", "sort": 2}, {"id": 1054, "content": "明明开创业，休拟作陪京", "sort": 3}], "notes": null, "dynasty": "清代", "category_id": 11, "category": "纳兰性德", "content_type": 0}