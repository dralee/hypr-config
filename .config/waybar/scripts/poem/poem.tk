{"id": 251, "title": "拟古·予生未三十", "author_id": 1, "author": "纳兰性德", "rhythmic": "拟古", "paragraphs": [{"id": 1146, "content": "予生未三十，忧愁居其半", "sort": 0}, {"id": 1147, "content": "心事如落花，春风吹已断", "sort": 1}, {"id": 1148, "content": "行当适远道，作记殊汗漫", "sort": 2}, {"id": 1149, "content": "寒食青草多，薄暮烟冥冥", "sort": 3}, {"id": 1150, "content": "山桃一夜红，茵箔随飘零", "sort": 4}, {"id": 1151, "content": "愿餐玉红草，一醉不复醒", "sort": 5}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}