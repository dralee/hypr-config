{"id": 20, "title": "浣溪沙·欲问江梅瘦几分", "author_id": 1, "author": "纳兰性德", "rhythmic": "浣溪沙", "paragraphs": [{"id": 72, "content": "欲问江梅瘦几分，只看愁损翠罗裙", "sort": 0}, {"id": 73, "content": "麝篝衾冷惜余熏", "sort": 1}, {"id": 74, "content": "可耐暮寒长倚竹，便教春好不开门", "sort": 2}, {"id": 75, "content": "枇杷花底校书人", "sort": 3}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}