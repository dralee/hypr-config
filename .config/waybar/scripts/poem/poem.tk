{"id": 179, "title": "菩萨蛮·窗前桃蕊娇如倦", "author_id": 1, "author": "纳兰性德", "rhythmic": "菩萨蛮", "paragraphs": [{"id": 819, "content": "窗前桃蕊娇如倦，东风泪洗胭脂面", "sort": 0}, {"id": 820, "content": "人在小红楼，离情唱《石州》", "sort": 1}, {"id": 821, "content": "夜来双燕宿，灯背屏腰绿", "sort": 2}, {"id": 822, "content": "香尽雨阑珊，薄衾寒不寒", "sort": 3}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}