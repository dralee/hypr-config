{"id": 68, "title": "清平乐·孤花片叶", "author_id": 1, "author": "纳兰性德", "rhythmic": "清平乐", "paragraphs": [{"id": 275, "content": "孤花片叶，断送清秋节", "sort": 0}, {"id": 276, "content": "寂寂绣屏香篆灭，暗里朱颜消歇", "sort": 1}, {"id": 277, "content": "谁怜散髻吹笙，天涯芳草关情", "sort": 2}, {"id": 278, "content": "懊恼隔帘幽梦，半床花月纵横", "sort": 3}], "notes": null, "dynasty": "清代", "category_id": 11, "category": "纳兰性德", "content_type": 0}