{"id": 237, "title": "汤泉应制·清时礼乐萃朝端", "author_id": 1, "author": "纳兰性德", "rhythmic": "汤泉应制", "paragraphs": [{"id": 1084, "content": "清时礼乐萃朝端，次第郊原引玉銮", "sort": 0}, {"id": 1085, "content": "河岳千年归带砾，寝园三月拜衣冠", "sort": 1}, {"id": 1086, "content": "便从畿甸亲民隐，更启神泉示从官", "sort": 2}, {"id": 1087, "content": "非独炎灵钟坎德，恩波深处不知寒", "sort": 3}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}