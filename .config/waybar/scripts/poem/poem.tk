{"id": 135, "title": "浣溪沙·雨歇梧桐泪乍收", "author_id": 1, "author": "纳兰性德", "rhythmic": "浣溪沙", "paragraphs": [{"id": 621, "content": "雨歇梧桐泪乍收，遣怀翻自忆从头", "sort": 0}, {"id": 622, "content": "摘花销恨旧风流", "sort": 1}, {"id": 623, "content": "帘影碧桃人已去，屧痕苍藓径空留", "sort": 2}, {"id": 624, "content": "两眉何处月如钩", "sort": 3}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}