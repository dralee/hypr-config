{"id": 240, "title": "梅花落", "author_id": 1, "author": "纳兰性德", "rhythmic": "汤泉应制", "paragraphs": [{"id": 1096, "content": "春色凤城来，寒梅逼岁开", "sort": 0}, {"id": 1097, "content": "条风初入树，缥雪渐侵苔", "sort": 1}, {"id": 1098, "content": "粉逐莺衣散，香黏蝶翅回", "sort": 2}, {"id": 1099, "content": "陇头人未返，急管莫频催", "sort": 3}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}