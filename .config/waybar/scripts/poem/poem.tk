{"id": 188, "title": "菩萨蛮·乌丝画作回纹纸", "author_id": 1, "author": "纳兰性德", "rhythmic": "菩萨蛮", "paragraphs": [{"id": 855, "content": "乌丝画作回纹纸，香煤暗蚀藏头字", "sort": 0}, {"id": 856, "content": "筝雁十三双，输他作一行", "sort": 1}, {"id": 857, "content": "相看仍似客，但道休相忆", "sort": 2}, {"id": 858, "content": "索性不还家，落残红杏花", "sort": 3}], "notes": null, "dynasty": "清代", "category_id": 11, "category": "纳兰性德", "content_type": 0}