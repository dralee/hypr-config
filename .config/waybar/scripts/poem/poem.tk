{"id": 205, "title": "遐方怨·欹角枕", "author_id": 1, "author": "纳兰性德", "rhythmic": "遐方怨", "paragraphs": [{"id": 926, "content": "欹角枕，掩红窗", "sort": 0}, {"id": 927, "content": "梦到江南，伊家博山沉水香", "sort": 1}, {"id": 928, "content": "湔裙归晚坐思量", "sort": 2}, {"id": 929, "content": "轻烟笼浅黛，月茫茫", "sort": 3}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}