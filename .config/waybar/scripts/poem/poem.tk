{"id": 220, "title": "菩萨蛮·客中愁损催寒夕", "author_id": 1, "author": "纳兰性德", "rhythmic": "菩萨蛮", "paragraphs": [{"id": 1003, "content": "客中愁损催寒夕，夕寒催损愁中客", "sort": 0}, {"id": 1004, "content": "门掩月黄昏，昏黄月掩门", "sort": 1}, {"id": 1005, "content": "翠衾孤拥醉，醉拥孤衾翠", "sort": 2}, {"id": 1006, "content": "醒莫更多情，情多更莫醒", "sort": 3}], "notes": null, "dynasty": "清代", "category_id": 11, "category": "纳兰性德", "content_type": 0}