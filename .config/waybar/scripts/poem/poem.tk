{"id": 128, "title": "踏莎行·倚柳题笺", "author_id": 1, "author": "纳兰性德", "rhythmic": "踏莎行", "paragraphs": [{"id": 573, "content": "倚柳题笺，当花侧帽，赏心应比驱驰好", "sort": 0}, {"id": 574, "content": "错教双鬓受东风，看吹绿影成丝早", "sort": 1}, {"id": 575, "content": "金殿寒鸦，玉阶春草，就中冷暖和谁道", "sort": 2}, {"id": 576, "content": "小楼明月镇长闲，人生何事缁尘老", "sort": 3}, {"id": 577, "content": " ", "sort": 4}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}