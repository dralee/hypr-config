{"id": 4, "title": "画堂春·一生一代一双人", "author_id": 1, "author": "纳兰性德", "rhythmic": "画堂春", "paragraphs": [{"id": 11, "content": "一生一代一双人，争教两处销魂", "sort": 0}, {"id": 12, "content": "相思相望不相亲，天为谁春", "sort": 1}, {"id": 13, "content": "浆向蓝桥易乞，药成碧海难奔", "sort": 2}, {"id": 14, "content": "若容相访饮牛津，相对忘贫", "sort": 3}], "notes": null, "dynasty": "清代", "category_id": 11, "category": "纳兰性德", "content_type": 0}