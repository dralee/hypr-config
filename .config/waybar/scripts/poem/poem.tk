{"id": 38, "title": "眼儿媚·独倚春寒掩夕扉", "author_id": 1, "author": "纳兰性德", "rhythmic": "眼儿媚", "paragraphs": [{"id": 152, "content": "独倚春寒掩夕扉，清露泣铢衣", "sort": 0}, {"id": 153, "content": "玉萧吹梦，金钗划影，悔不同携", "sort": 1}, {"id": 154, "content": "刻残红烛曾相待，旧事总依稀", "sort": 2}, {"id": 155, "content": "料应遗恨，月中教去，花底催归", "sort": 3}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}