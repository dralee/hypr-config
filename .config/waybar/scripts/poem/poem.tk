{"id": 6, "title": "酒泉子·谢却荼蘼", "author_id": 1, "author": "纳兰性德", "rhythmic": "酒泉子", "paragraphs": [{"id": 21, "content": "谢却荼蘼，一片月明如水", "sort": 0}, {"id": 22, "content": "篆香消，犹未睡，早鸦啼", "sort": 1}, {"id": 23, "content": "嫩寒无赖罗衣薄，休傍阑干角", "sort": 2}, {"id": 24, "content": "最愁人，灯欲落，雁还飞", "sort": 3}], "notes": null, "dynasty": "清代", "category_id": 11, "category": "纳兰性德", "content_type": 0}