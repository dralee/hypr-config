{"id": 64, "title": "好事近·马首望青山", "author_id": 1, "author": "纳兰性德", "rhythmic": "好事近", "paragraphs": [{"id": 258, "content": "马首望青山，零落繁华如此", "sort": 0}, {"id": 259, "content": "再向断烟衰草，认藓碑题字", "sort": 1}, {"id": 260, "content": "休寻折载话当年，只洒悲秋泪", "sort": 2}, {"id": 261, "content": "斜日十三陵下，过新丰猎骑", "sort": 3}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}