{"id": 59, "title": "浣溪沙·肠断班骓去未还", "author_id": 1, "author": "纳兰性德", "rhythmic": "浣溪沙", "paragraphs": [{"id": 236, "content": "肠断班骓去未还，绣屏深锁凤箫寒", "sort": 0}, {"id": 237, "content": "一春幽梦有无间", "sort": 1}, {"id": 238, "content": "逗雨疏花浓淡改，关心芳草浅深难", "sort": 2}, {"id": 239, "content": "不成风月转摧残", "sort": 3}], "notes": null, "dynasty": "清代", "category_id": 11, "category": "纳兰性德", "content_type": 0}