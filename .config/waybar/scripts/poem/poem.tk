{"id": 46, "title": "采桑子·当时错", "author_id": 1, "author": "纳兰性德", "rhythmic": "采桑子", "paragraphs": [{"id": 185, "content": "而今才道当时错，心绪凄迷", "sort": 0}, {"id": 186, "content": "红泪偷垂，满眼春风百事非", "sort": 1}, {"id": 187, "content": "情知此后来无计，强说欢期", "sort": 2}, {"id": 188, "content": "一别如斯，落尽梨花月又西", "sort": 3}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}