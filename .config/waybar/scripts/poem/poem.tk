{"id": 186, "title": "菩萨蛮·惜春春去惊新燠", "author_id": 1, "author": "纳兰性德", "rhythmic": "菩萨蛮", "paragraphs": [{"id": 847, "content": "惜春春去惊新燠，粉融轻汗红绵扑", "sort": 0}, {"id": 848, "content": "妆罢只思眠，江南四月天", "sort": 1}, {"id": 849, "content": "绿阴帘半揭，此景清幽绝", "sort": 2}, {"id": 850, "content": "行度竹林风，单衫杏子红", "sort": 3}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}