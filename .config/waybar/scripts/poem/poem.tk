{"id": 106, "title": "菩萨蛮·朔风吹散三更雪", "author_id": 1, "author": "纳兰性德", "rhythmic": "菩萨蛮", "paragraphs": [{"id": 458, "content": "朔风吹散三更雪，倩魂犹恋桃花月", "sort": 0}, {"id": 459, "content": "梦好莫催醒，由他好处行", "sort": 1}, {"id": 460, "content": "无端听画角，枕畔红冰薄", "sort": 2}, {"id": 461, "content": "塞马一声嘶，残星拂大旗", "sort": 3}], "notes": null, "dynasty": "清代", "category_id": 11, "category": "纳兰性德", "content_type": 0}