{"id": 132, "title": "赤枣子·风淅淅", "author_id": 1, "author": "纳兰性德", "rhythmic": "赤枣子", "paragraphs": [{"id": 607, "content": "风淅淅，雨纤纤", "sort": 0}, {"id": 608, "content": "难怪春愁细细添", "sort": 1}, {"id": 609, "content": "记不分明疑是梦，梦来还隔一重帘", "sort": 2}, {"id": 610, "content": " ", "sort": 3}], "notes": null, "dynasty": "清代", "category_id": 11, "category": "纳兰性德", "content_type": 0}