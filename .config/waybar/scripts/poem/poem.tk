{"id": 133, "title": "浣溪沙·欲寄愁心朔雁边", "author_id": 1, "author": "纳兰性德", "rhythmic": "浣溪沙", "paragraphs": [{"id": 611, "content": "欲寄愁心朔雁边，西风浊酒惨离颜", "sort": 0}, {"id": 612, "content": "黄花时节碧云天", "sort": 1}, {"id": 613, "content": "古戍烽烟迷斥堠，夕阳村落解鞍鞯", "sort": 2}, {"id": 614, "content": "不知征战几人还", "sort": 3}], "notes": null, "dynasty": "清朝", "category_id": 11, "category": "纳兰性德", "content_type": 0}