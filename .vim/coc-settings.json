{
  "colors.enable": true,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "all",
  "prettier.bracketSpacing": false,
  "languageserver": {
    "sql": {
      "module": "/usr/local/lib/node_modules/sql-language-server/dist/bin/cli.js",
      "args": [
        "up",
        "--method",
        "node-ipc"
      ],
      "filetypes": [
        "sql",
        "mysql"
      ]
    },
    "systemd-language-server": {
      "command": "systemd-language-server",
      "filetypes": [
        "systemd"
      ]
    },
    "kotlin": {
      "command": "~/.local/share/lsp/kotlin-server/bin/kotlin-language-server",
      "filetypes": [
        "kotlin"
      ]
    },
    "lua": {
      "command": "~/.local/share/lsp/lua-language-server/bin/lua-language-server",
      "args": [],
      "rootPatterns": [
        ".git"
      ],
      "filetypes": [
        "lua"
      ]
    }
  }
}
